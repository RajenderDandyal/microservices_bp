pipeline {
  agent {
    docker {
        image 'csanchez/maven:latest'  // Use an official Jenkins & Maven image
        reuseNode true            // Recommended for performance
        args '-v /var/run/docker.sock:/var/run/docker.sock' // Keep for docker commands
    }
  }
  // environment {
  //   // DOCKERHUB_USER = credentials('dockerhub-user')
  //   // DOCKERHUB_PASSWORD = credentials('dockerhub-password')
  // }
  stages {
    stage('Unit Test') {
      steps {
        sh 'mvn test -U'
      }
    }
    stage('Build') {
      steps {
        sh 'mvn clean package -U -DskipTests'
      }
    }
    // stage('SonarQube Analysis') {
    //   environment {
    //     SONAR_TOKEN = credentials('sonar-token')
    //   }
    //   steps {
    //     sh 'mvn sonar:sonar -Dsonar.projectKey=microservices -Dsonar.host.url=http://sonarqube:9000 -Dsonar.login=$SONAR_TOKEN'
    //   }
    // }
    stage('Debug Docker Login') {
      agent {
        docker { image 'jenkins/docker' }
      }
      steps {
        // This block securely loads credentials by their ID into environment variables
        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
          echo 'Attempting to log in to Docker Hub...'
          echo "Using Docker Hub Username: ${DOCKER_USERNAME}"

          // This command attempts the login. It pipes the password securely.
          // The output of this command will tell us the exact error.
          // We add '|| true' so the pipeline doesn't stop if the login fails here.
          sh "echo \$DOCKER_PASSWORD | docker login -u \$DOCKER_USERNAME --password-stdin || true"
        }
      }
    }
    stage('Build and Push Docker Image') {
      steps {
        script {
          // IMPORTANT: Change this to your Docker Hub username and image name!
          def imageName = "rajenderdandyal/microservices:${env.BUILD_NUMBER}"

          echo "Building and pushing image: ${imageName}"

          docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
            def customImage = docker.build(imageName)

            // Push with the build number tag
            customImage.push()

            // Push with the 'latest' tag
            customImage.push('latest')

            echo "Successfully pushed ${imageName} and ${imageName.split(':')[0]}:latest"
          }
        }
      }
    }
  }
  post {
    always {
      cleanWs()
    }
  }
}
