// Jenkinsfile
// Jenkinsfile
pipeline {
    // Define a global agent that has the Docker CLI.
    // This agent will run all stages that don't specify their own agent.
    // Most importantly, it will orchestrate the other 'docker' agents.
    agent {
        docker {
            image 'jenkins/docker'
            // This ensures the container itself can run docker commands
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {
        stage('Checkout Code') {
            steps {
                cleanWs()
                checkout scm
                echo "Code checked out successfully."
            }
        }

        stage('Run Maven Tests') {
            // This stage needs a different environment (with Maven).
            // The main 'jenkins/docker' agent will start this container for us.
            agent {
                docker { image 'maven:3.8-jdk-11' }
            }
            steps {
                echo "Running Maven tests inside a dedicated Maven container..."
                sh 'mvn test'
            }
        }

        stage('Build and Push Docker Image') {
            // This stage can run on the original 'jenkins/docker' agent
            // because it has the docker CLI.
            steps {
                script {
                    def imageName = "rajenderdandyal/microservices_bp:${env.BUILD_NUMBER}"
                    echo "Building and pushing image: ${imageName}"

                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        def customImage = docker.build(imageName)
                        customImage.push()
                        customImage.push('latest')
                        echo "Successfully pushed ${imageName} and ${imageName.split(':')[0]}:latest"
                    }
                }
            }
        }
    }
}