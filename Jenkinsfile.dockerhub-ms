// Jenkinsfile
pipeline {
    // We will define a specific agent for each stage.
    agent none

    stages {
        stage('Checkout Code') {
            // This stage just needs a workspace. The default 'docker-agent' we
            // configured in the UI is perfect. It's a basic Jenkins agent.
            agent {
                label 'docker-agent' 
            }
            steps {
                // Clean the workspace and checkout the code from Git
                cleanWs()
                checkout scm
                echo "Code checked out successfully."

                // Stash the code (save it) so it can be used in other agents
                stash name: 'source', includes: '**'
            }
        }

        stage('Run Maven Tests') {
            // For this stage, we need Maven. So we use the official Maven image.
            agent {
                docker { image 'maven:3.8-jdk-11' }
            }
            steps {
                // Unstash (retrieve) the code from the 'Checkout' stage
                unstash 'source'
                echo "Running Maven tests inside a Maven container..."
                sh 'mvn test'
            }
        }

        stage('Build and Push Docker Image') {
            // For this stage, we need the 'docker' command.
            // The 'jenkins/docker' image is designed for this.
            agent {
                docker { image 'jenkins/docker' }
            }
            steps {
                // Unstash the code again into this new agent's workspace
                unstash 'source'
                script {
                    def imageName = "rajenderdandyal/microservices_bp:${env.BUILD_NUMBER}"
                    echo "Building and pushing image: ${imageName}"

                    // Use the Docker Hub credentials we stored in Jenkins
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        
                        // Build the image from the Dockerfile in our source code
                        def customImage = docker.build(imageName)
                        
                        // Push the image to Docker Hub
                        customImage.push()
                        customImage.push('latest')

                        echo "Successfully pushed ${imageName} and ${imageName.split(':')[0]}:latest"
                    }
                }
            }
        }
    }
}