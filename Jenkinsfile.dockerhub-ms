// Jenkinsfile
pipeline {
    // No global agent. We will define a specific agent for each stage.
    agent {
      docker {
        image 'rajenderdandyal/jenkins-repo:jenkins-master-slave'
      }
    }

    stages {
        stage('Checkout Code') {
      // This stage just needs a place to checkout code.
      // We'll use a basic agent that the Jenkins controller can start.
      // agent any
      steps {
        cleanWs()
        checkout scm
        echo 'Code checked out successfully.'
        // Stash the code (save it) so it can be used in the other agents.
        stash name: 'source', includes: '**'
      }
        }
        stage('Run Maven Tests') {
      // For this stage, we need Maven. So we use the official Maven image.
      // Your controller now has the 'docker' command to start this agent.
      // agent {
      //   docker { image 'maven:4.0.0-rc-4-amazoncorretto-21' }
      // }
      steps {
        // Unstash (retrieve) the code from the 'Checkout' stage.
        unstash 'source'
        echo 'Running Maven tests inside a Maven container...'
        sh 'mvn test'
      }
        }
      stage('Build') {
        // agent {
        // docker { image 'maven:4.0.0-rc-4-amazoncorretto-21' }
        // }
        steps {
          sh 'mvn clean package -U -DskipTests'
        }
      }
        stage('Build and Push Docker Image') {
      // For this stage, we need the 'docker' command.
      // We use the 'jenkins/docker' image, which is designed for this.
      // agent {
      //   docker {
      //     image 'docker:latest'
      //   }
      // }
      // Add the JDK tool that we configured in Jenkins
      tools {
        jdk 'jdk21'
      }
      steps {
        // Unstash the code again into this new agent's workspace.
        unstash 'source'
        script {
          def imageName = "rajenderdandyal/microservices:${env.BUILD_NUMBER}"
          echo "Building and pushing image: ${imageName}"

          // Use the Docker Hub credentials stored in Jenkins.
          // This command runs inside the 'jenkins/docker' container,
          // which has the docker CLI and can log in correctly.
          docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
            echo 'Login successful. Building image...'
            def customImage = docker.build(imageName)

            echo 'Image built. Pushing to Docker Hub...'
            customImage.push()
            customImage.push('latest')

            echo "Successfully pushed ${imageName} and ${imageName.split(':')[0]}:latest"
          }
        }
      }
        }
    }
}
